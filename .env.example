# Marlowe Motorcars — environment configuration.
#
# Copy to `.env.local` for development, and set the same values in your hosting
# provider for production. No secrets belong in this file or in git.
#
# Run `npm run verify:production` to see which of these are still missing.

# --- Canonical origin --------------------------------------------------------
# The branded domain, with scheme and no trailing slash.
# Leave unset on Vercel and canonicals resolve to the deployment URL, which is
# correct but off-brand. See "Connecting the branded domain" in the README.
NEXT_PUBLIC_SITE_URL=

# --- Public contact details --------------------------------------------------
# Required. The address enquiries are answered from.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional. Leave unset to hide the phone number everywhere on the site.
NEXT_PUBLIC_CONTACT_PHONE=

# Optional. A truthful service area or city/state — not a showroom address.
NEXT_PUBLIC_SERVICE_AREA=

# --- Business identity -------------------------------------------------------
# Optional. Registered trading entity, once there is one.
NEXT_PUBLIC_LEGAL_ENTITY=

# 'sourcing-agent' | 'dealer'. Anything else emits no organisation structured data.
# 'dealer' is a regulated description and additionally requires the licence fields.
NEXT_PUBLIC_BUSINESS_CLASSIFICATION=

# Only if the business genuinely holds a motor vehicle dealer licence.
NEXT_PUBLIC_DEALER_LICENSE_NUMBER=
NEXT_PUBLIC_DEALER_LICENSE_JURISDICTION=

# Optional. "Label|https://…" pairs, comma-separated. Real profiles only.
NEXT_PUBLIC_SOCIAL_LINKS=

# --- Enquiry email delivery (Resend) -----------------------------------------
# Required for the enquiry form to accept messages. Without these the form is
# replaced by a direct email address rather than silently discarding submissions.
RESEND_API_KEY=

# Must be on a domain verified in Resend, e.g. enquiries@marlowemotorcars.com
INQUIRY_FROM_EMAIL=

# Where enquiries are delivered. Defaults to NEXT_PUBLIC_CONTACT_EMAIL if unset.
INQUIRY_TO_EMAIL=

# --- Indexing ----------------------------------------------------------------
# Set to 'false' to force noindex on a staging deployment that is otherwise complete.
NEXT_PUBLIC_ALLOW_INDEXING=
